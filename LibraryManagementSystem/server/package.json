{
  "name": "library-management-system-api",
  "version": "1.0.0",
  "description": "Production-grade Library Management System REST API featuring JWT authentication, RBAC authorization, API key validation, password hashing, HTTPS/TLS security, and Zod input validation.",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "build": "echo 'Ready'",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "generate-cert": "node scripts/generateCerts.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "selfsigned": "^2.4.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "supertest": "^7.0.0",
    "vitest": "^3.0.7"
  }
}
